[Format]
Type=PortableApps.comFormat
Version=3.7 # Version of the PortableApps format, not of Song

[Details]
Name=Finalverse Song Studio Portable
AppId=FinalverseSongStudioPortable
Publisher=Finalverse Inc. and contributors
Homepage=song.finalverse.com
Category=Music & Video
Description=Finalverse Song Studio is an open-source music creation and notation workspace packaged as a portable app.
Language=Multilingual

[License]
Shareable=true
OpenSource=true
Freeware=true
CommercialUse=true

[Version]
PackageVersion=@MUSE_APP_VERSION@.1
DisplayVersion=@MUSE_APP_VERSION@

[Control]
Icons=1
Start=MuseScorePortable.exe

[Associations]
FileTypes=mscz, mscx, mscs
Protocols=musescore

[FileTypeIcons]
mscz=custom
mscx=custom
mscs=custom
